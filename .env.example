# Copy this file to .env and fill in the values.

# Port the Express server listens on
PORT=5000

# MongoDB connection string (local MongoDB by default)
MONGODB_URI=mongodb://127.0.0.1:27017/secura

# Ganache local blockchain RPC URL (default Ganache GUI port is 7545;
# ganache-cli defaults to 8545 - check your Ganache instance)
BLOCKCHAIN_RPC_URL=http://127.0.0.1:7545

# Address of the deployed Secura.sol contract (filled in after `npm run deploy`)
CONTRACT_ADDRESS=

# Private key of a Ganache development account used to sign transactions.
# This is ONLY safe because it is a local Ganache test account with fake
# test ETH. NEVER use a real wallet's private key here, and never commit
# a real private key to source control.
PRIVATE_KEY=
